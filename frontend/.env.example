# Kopier til frontend/.env og fyll inn fra Supabase (Settings -> API).
# anon key er offentlig (trygg i frontend); .env er likevel gitignorert.
VITE_SUPABASE_URL=https://<ditt-prosjekt-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<din-anon-public-key>

# API-base. La stå TOM for web (samme opphav / Vite-proxy).
# For mobil-app (Capacitor): sett til den utplasserte backend-URL-en, f.eks.
#   VITE_API_BASE=https://api.din-app.no
VITE_API_BASE=
