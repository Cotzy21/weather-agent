# Brukes av `npm run build:native` / `npm run ios:sync` (vite --mode native).
# Den native appen kjører fra lokale filer og har ingen egen server, så alle API-kall må gå til den utplasserte backenden.
# Adressen er offentlig. Bytt den hvis backenden flyttes (f.eks. eget domene). VITE_SUPABASE_URL og VITE_SUPABASE_ANON_KEY
# kommer fra frontend/.env (lokalt) eller repo-variabler (CI), som ved vanlig bygg.
VITE_API_BASE=https://weather-agent-t801.onrender.com
