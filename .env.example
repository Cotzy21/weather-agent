# Kopier til .env (samme mappe, gitignorert) og fyll inn. Leses av backend ved oppstart.

# Supabase -> Project Settings -> Database -> Connection string (Session pooler, JDBC)
SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-host>:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<prosjekt-ref>
SPRING_DATASOURCE_PASSWORD=<database-passord>

# Supabase -> Project Settings -> API. Nyere prosjekter: JWKS-URI. Eldre: JWT secret.
SUPABASE_JWKS_URI=https://<prosjekt-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# Valgfritt: sky-LLM (tom = lokal LM Studio/Ollama). Bruk property-navn her.
# llm.base-url=https://api.openai.com/v1
# llm.api-key=
